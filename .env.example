# TrueNAS REST API Configuration
TRUENAS_HOST=192.168.10.10
TRUENAS_USER=root
TRUENAS_PASSWORD=your_password_here

# Optional: Use API key instead of password
# Generate at: TrueNAS UI -> Top Right User Menu -> API Keys
# TRUENAS_API_KEY=1-xxxxxxxxxxxxxxxxxxxx

# --- VM-state backup (deploy.sh) -------------------------------------------
# deploy.sh provisions the NAS-side VM-state backup (uploads the script/config/
# key, plus a ZFS snapshot task + cron job) via the REST API. An API key above
# is recommended. All settings below are optional and have sensible defaults:
# VM_BACKUP_DATASET=tank/vms                  # zvol parent dataset to snapshot
# VM_BACKUP_DEST=/mnt/tank/archive/vm-state   # MUST live in a Cloud-Synced dataset
# NAS_SCRIPT=/root/vm-state-backup.sh
# NAS_CONF=/root/vm-state-backup.conf
# NAS_KEY=/root/id_vmbackup
# SNAP_KEEP_VALUE=2
# SNAP_KEEP_UNIT=WEEK
# SNAP_MIN=30
# SNAP_HOUR=3
# CRON_MIN=30
# CRON_HOUR=4
